# ReasoningBank 复现配置模板
# 用法：复制成 .env（放在仓库根目录），填好后所有脚本/程序都会自动读取。
# 代码位置：WebArena/utils/reasoningbank_llm.py（加载逻辑与全部变量说明）

# ---------------------------------------------------------------------------
# 1) 对话模型：任意 OpenAI 兼容接口
# ---------------------------------------------------------------------------
# DeepSeek 官方：https://api.deepseek.com/v1  模型：deepseek-chat / deepseek-reasoner
# 阿里 DashScope 兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
# 月之暗面：https://api.moonshot.cn/v1        模型：kimi-k2-...
# 本地 vLLM：http://127.0.0.1:8000/v1         key 随便填（代码里会用 EMPTY 兜底）
RB_CHAT_BASE_URL=https://api.deepseek.com/v1
RB_CHAT_API_KEY=sk-在这里填你的key
RB_CHAT_MODEL=deepseek-chat

# judge（autoeval 打分）和记忆生成也可以用不同的模型；不填就等于 RB_CHAT_MODEL
# RB_JUDGE_MODEL=deepseek-chat

# 单次输出上限。DeepSeek 是 8192，Gemini/OpenAI 可以更大
RB_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# 2) Embedding：DeepSeek 没有 /embeddings 接口，必须另配一个来源
# ---------------------------------------------------------------------------
# 当前默认：本地跑 BAAI/bge-m3（2.2GB 模型，第一次运行自动下载；不花钱、不用 key）
# 需要 pip install sentence-transformers，并且把 HF_ENDPOINT 指到国内镜像
RB_EMBED_PROVIDER=local
RB_EMBED_MODEL=BAAI/bge-m3
HF_ENDPOINT=https://hf-mirror.com

# auto 的挑选顺序：有 RB_EMBED_MODEL 且有 key -> openai 兼容；有 GEMINI_API_KEY -> Gemini；
# 有 RB_EMBED_MODEL 且装了 sentence-transformers -> 本地；否则 -> hash（离线冒烟，检索质量很差）
# RB_EMBED_PROVIDER=auto

# 换成云端 embedding（速度更快、不用占 2GB 磁盘，但要注册）时改成：
# RB_EMBED_PROVIDER=openai
# 方案 A：SiliconFlow 的 bge-m3
# RB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# RB_EMBED_API_KEY=sk-你的硅基流动key
# RB_EMBED_MODEL=BAAI/bge-m3

# 方案 B：阿里 DashScope
# RB_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RB_EMBED_API_KEY=sk-你的dashscope-key
# RB_EMBED_MODEL=text-embedding-v4

# 方案 C：OpenAI 官方
# RB_EMBED_MODEL=text-embedding-3-small

# 本地更小的模型（磁盘紧张时用，例如只跑 shopping）：
# RB_EMBED_MODEL=BAAI/bge-large-en-v1.5   # 1.3GB，纯英文
# RB_EMBED_MODEL=BAAI/bge-small-en-v1.5   # 130MB，最省，检索精度差一点

# ---------------------------------------------------------------------------
# 3) WebArena 网站地址（起容器后填；容器端口映射见 REPRODUCE.md）
# ---------------------------------------------------------------------------
WA_SHOPPING=http://127.0.0.1:7770
WA_SHOPPING_ADMIN=http://127.0.0.1:7780/admin
WA_REDDIT=http://127.0.0.1:9999
WA_GITLAB=http://127.0.0.1:8023
WA_WIKIPEDIA=http://127.0.0.1:8888/wikipedia_en_all_maxi_2022-05/A/User:The_other_Kiwix_guy/Landing
# WA_MAP / WA_HOMEPAGE 只有 map 类任务和多站任务才需要，可留空

# ---------------------------------------------------------------------------
# 4) 运行环境
# ---------------------------------------------------------------------------
# 下载 Chromium 的镜像（国内直连 playwright CDN 很慢）
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
# HuggingFace 镜像
HF_ENDPOINT=https://hf-mirror.com
